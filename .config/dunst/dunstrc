[global]
    monitor = DP-2
    follow = none

    width = (100, 300)
    offset = (5, 5)
    notification_limit = 10

    progress_bar_height = 14
    progress_bar_frame_width = 0
    progress_bar_min_width = 100
    progress_bar_corner_radius = 7
    progress_bar_corners = bottom-left, top-right

    padding = 10
    text_icon_padding = 12
    frame_width = 1
    gap_size = 6
    idle_threshold = 120
    corner_radius = 10
    corners = bottom, top-left

    font = JetBrainsMono Nerd Font 13
    format = "<b>%s</b>\n%b"

    enable_recursive_icon_lookup = true
    icon_theme = Papirus-Dark, Papirus, hicolor
    icon_position = right

    history_length = 40

    dmenu = /usr/bin/env fuzzel --dmenu
    browser = /usr/bin/env xdg-open
    mouse_left_click = do_action, close_current
    mouse_middle_click = context
    mouse_right_click = close_current

[urgency_low]
    background = "#0f1117"
    foreground = "#c0c0c0"
    frame_color = "#1e222a"
    highlight = "#1e222a, #c0c0c0"

[urgency_normal]
    background = "#0f1117"
    foreground = "#e0e0e0"
    frame_color = "#00ac89"
    highlight = "#00ac89, #0d3531"
    timeout = 15
    override_pause_level = 30

[urgency_critical]
    background = "#0d3531"
    frame_color = "#e65100"
    highlight = "#e65100, #ffffff"
    timeout = 0
    override_pause_level = 60
